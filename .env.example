# Python reads the shell environment; Compose also reads .env.
APP_ENV=development
APP_ORIGIN=http://localhost:8000
PORT=8000
HOST=127.0.0.1
# Leave DATABASE_URL and REDIS_URL unset for the local development fallback.
# DATABASE_URL=postgresql+psycopg://catchy:password@localhost:5432/catchy
# REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Empty uses 1.2 seconds for Ollama or 5 seconds for OpenAI/Gemini (max 10).
LLM_TIMEOUT=
# Set LLM_PROVIDER=openai to enable. Keep the real key only in server secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set LLM_PROVIDER=gemini to use Google instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ASR_WS_URL=
ASR_SERVICE_TOKEN=
ADMIN_EMAILS=
DEV_EMAIL_CODES=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
METRICS_TOKEN=

# Only event name and timestamp are posted; no request, path, account or call content.
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=
